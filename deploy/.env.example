# Installation settings template. Copy to .env beside compose.release.yaml
# when creating a NEW installation. Do not overwrite an existing .env.

# Keep this stable after installation: it identifies the storage to reuse.
COMPOSE_PROJECT_NAME=weekflow

# API and web images must both be published with this exact version first.
WF_IMAGE_TAG=0.1.0-preview.1

# Hostname or IPv4 address only: no https://, port, or path here.
# localhost is for this computer only.
# For phone/other-computer access, use this server's LAN IP or hostname
# and change WF_BIND_ADDRESS below to 0.0.0.0.
WF_SERVER_HOST=localhost

# Ports exposed by the web gateway. Keep these free of other applications.
WF_HTTPS_PORT=9443
WF_HTTP_PORT=9080

# Compose calculates these from the host and HTTPS port above.
# Change WF_SERVER_HOST instead of repeating an IP in multiple settings.
WF_SITE_ADDRESS=${WF_SERVER_HOST}:${WF_HTTPS_PORT}
WF_TLS_SERVER_NAME=${WF_SERVER_HOST}

# 127.0.0.1 accepts connections from this computer only.
# 0.0.0.0 accepts IPv4 connections on all host interfaces, subject to firewalls.
WF_BIND_ADDRESS=127.0.0.1

# Database credentials for this installation. These are separate from
# the WeekFlow owner username and password created through the login screen.
# Choose the database settings before first startup and keep them stable.
# Editing this password later does not change an existing database password.
WF_POSTGRES_DB=weekflow
WF_POSTGRES_USER=weekflow

# Required: enter your own randomly generated password before startup.
# You can generate one with: openssl rand -hex 32
# Do not put a real password in this EXAMPLE file or commit your real .env.
WF_POSTGRES_PASSWORD=

# Local HTTPS certificates must be trusted on each client device.
# Preserve the Caddy data volume to retain the installation's certificate authority.
