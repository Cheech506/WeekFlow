# Copy this file to .env in the WeekFlow repository root.
# This example is for a separate, local Docker installation test.

# Groups the containers, networks, and named volumes under this project.
# Keep this value stable after installing so Docker reuses the same data.
COMPOSE_PROJECT_NAME=weekflow

# Local test URL: https://localhost:9443
# For this custom port, the port in WF_SITE_ADDRESS must match WF_HTTPS_PORT.
WF_SITE_ADDRESS=localhost:9443
WF_HTTPS_PORT=9443
WF_HTTP_PORT=9080

# Accept browser connections only from this computer during the first test.
# Remote-device access will be configured after local setup is verified.
WF_BIND_ADDRESS=127.0.0.1

# PostgreSQL settings for this new installation.
# This is a database password, separate from the WeekFlow owner login.
WF_POSTGRES_DB=weekflow
WF_POSTGRES_USER=weekflow
WF_POSTGRES_PASSWORD=
