# This file applies when the WeekFlow repository root is the build context.
# Allow only files needed to build the frontend and its Caddy gateway.
**
!.dockerignore
!package.json
!package-lock.json
!app.json
!tsconfig.json
!metro.config.js
!babel.config.js
!app/
!app/**
!assets/
!assets/**
!components/
!components/**
!constants/
!constants/**
!context/
!context/**
!hooks/
!hooks/**
!lib/
!lib/**
!public/
!public/**
!deploy/
!deploy/**

# Keep machine-specific settings and generated files out of allowed folders.
**/.env
**/.env.*
**/node_modules
**/.expo
**/dist
**/web-build
**/__pycache__
**/*.py[cod]
**/*.log
**/*.tsbuildinfo
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
**/*.sqlite-*
**/*.sqlite3-*
**/*.sql
**/*.dump
**/*.backup
**/*.pem
**/*.key
**/*.p12
**/*.pfx
